{
  "name": "tocineta-sonrie-os",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Operativo Local Tocineta Sonrie - Monorepo de Produccion",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tocineta/shared run build && pnpm --filter @tocineta/server run build && pnpm --filter @tocineta/web run build",
    "test": "pnpm -r run test",
    "guard": "node scripts/ui-guard.mjs",
    "import:photos": "node scripts/import-photos.mjs",
    "lint": "pnpm -r run lint && node scripts/ui-guard.mjs",
    "db:migrate": "pnpm --filter @tocineta/server run db:migrate",
    "db:init-prod": "pnpm --filter @tocineta/server run db:init-prod",
    "db:reset-prod": "pnpm --filter @tocineta/server run db:reset-prod",
    "db:seed-demo": "pnpm --filter @tocineta/server run db:seed-demo",
    "dev:server": "pnpm --filter @tocineta/server run dev",
    "dev:web": "pnpm --filter @tocineta/web run dev",
    "start": "pnpm --filter @tocineta/server run start",
    "probe": "tsx tools/g0-probe/probe.ts",
    "probe:list": "tsx tools/g0-probe/probe.ts --list",
    "probe:usb": "tsx tools/g0-probe/probe.ts --usb",
    "probe:tcp": "tsx tools/g0-probe/probe.ts --tcp",
    "probe:server": "tsx tools/g0-probe/probe.ts --port 3000",
    "guard:visual": "node scripts/guard-visual.mjs",
    "r2:e2e": "playwright test -c playwright.r2.config.ts",
    "r2:status": "node scripts/r2-status.mjs"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "better-sqlite3": "^13.0.3",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
