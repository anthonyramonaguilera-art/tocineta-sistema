# ==============================================================================
# SISTEMA OPERATIVO GASTRONÓMICO TOCINETA — PLANTILLA DE ENTORNO (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR Y BASE DE DATOS
# ------------------------------------------------------------------------------
# Entorno de ejecución (production | development | test)
NODE_ENV=production

# Dirección de host y puerto de escucha
HOST=0.0.0.0
PORT=3000

# Nivel de registro de logs (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Ruta de la base de datos principal SQLite
DB_PATH=./data/tocineta.db

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y CONTROL DE ACCESO
# ------------------------------------------------------------------------------
# true = bloquea sin sesión o sin rol; no dejar en false en producción
ENFORCE_AUTH=true

# Orígenes adicionales permitidos para CORS (separados por coma, ej: https://admin.tocineta.com)
CORS_ALLOWED_ORIGINS=

# Clave pública de actualización del sistema (dejar vacía para usar la oficial integrada)
UPDATE_PUBLIC_KEY=

# Claves públicas Age para encriptación de respaldos (dejar vacías si se aprovisionan en instalación)
AGE_RECIPIENT_ADMIN=
AGE_RECIPIENT_SECURE=
AGE_KEYS_PROVISIONED=false

# ------------------------------------------------------------------------------
# 3. IMPRESIÓN Y HARDWARE POS
# ------------------------------------------------------------------------------
# Simulación de impresión en desarrollo (true = no envía comandos ESC/POS al spooler de Windows)
PRINTER_DEV_SIMULATION=false

# Intervalo de keepalive para mantener activa la conexión con impresoras térmicas (ms, 240000 = 4 min)
PRINTER_KEEPALIVE_MS=240000

# ------------------------------------------------------------------------------
# 4. RESPALDOS EN DISPOSITIVOS EXTERNOS (USB) Y TELEGRAM
# ------------------------------------------------------------------------------
# Ruta directa de respaldo en unidad USB (opcional: si no existe, solo se envía a Telegram)
USB_BACKUP_PATH=

# ------------------------------------------------------------------------------
# 5. MONITOREO, ALERTAS Y RESPALDOS POR TELEGRAM
# ------------------------------------------------------------------------------
# Token del bot de Telegram emitido por @BotFather (requerido para alertas y respaldos .db.age)
TELEGRAM_BOT_TOKEN=

# Chat ID o identificador del administrador/canal de alertas y recepción de respaldos
TELEGRAM_CHAT_ID=

# IDs numéricos de Telegram autorizados a enviar actualizaciones (separados por coma)
# Obtener en: https://api.telegram.org/bot<TOKEN>/getUpdates → message.from.id
TELEGRAM_ADMIN_IDS=
# ------------------------------------------------------------------------------
# 6. ACTUALIZADOR AUTOMATICO VIA GITHUB RELEASES (R3)
# ------------------------------------------------------------------------------
# Token de acceso personal de GitHub (PAT) con permiso 'contents:read' para repositorio privado
GITHUB_TOKEN=

# Repositorio oficial en GitHub (formato: organizacion/repositorio)
GITHUB_REPO=

# Nombre del servicio de Windows a gestionar (por defecto TocinetaServer o autodetectado)
SERVICE_NAME=TocinetaServer
