# ==============================================================================
# SISTEMA OPERATIVO LOCAL TOCINETA — ENTORNO DEL SERVIDOR (.env.example)
# ==============================================================================

# Entorno de ejecución (production | development | test)
NODE_ENV=production

# Red y puertos
HOST=0.0.0.0
PORT=3000

# Registro de eventos
LOG_LEVEL=info

# Ruta a la base de datos principal SQLite
DB_PATH=./data/tocineta.db

# Control de autenticación estricta (true = exige sesión/rol válido)
ENFORCE_AUTH=true

# Clave pública de actualización
UPDATE_PUBLIC_KEY=

# Claves públicas Age para respaldo criptográfico
AGE_RECIPIENT_ADMIN=
AGE_RECIPIENT_SECURE=
AGE_KEYS_PROVISIONED=false

# Impresión POS y hardware
PRINTER_DEV_SIMULATION=false
PRINTER_KEEPALIVE_MS=240000

# Ruta de respaldo en almacenamiento USB (opcional)
USB_BACKUP_PATH=

# Notificaciones y respaldos por Telegram
# Token emitido por @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID personal del administrador o grupo directivo (NUNCA el ID del propio bot)
TELEGRAM_CHAT_ID=

# Servicio de Windows
SERVICE_NAME=TocinetaServer
