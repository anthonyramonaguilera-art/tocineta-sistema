{
  "name": "@tocineta/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true });\"",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset-prod": "tsx src/db/reset-for-production.ts",
    "db:seed:users": "tsx src/modules/auth/seed-users.ts",
    "print:release1": "tsx scripts/print-physical-release1.ts",
    "physical:release1": "tsx scripts/physical-release1-check.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@tocineta/shared": "workspace:*",
    "age-encryption": "^0.3.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.39.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.1",
    "pdfkit": "^0.20.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.7"
  }
}
